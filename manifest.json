{
  "manifest_version": 3,
  "name": "Quick Converter",
  "version": "1.0.0",
  "description": "Convert selected values directly from webpages.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://api.frankfurter.dev/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Quick Converter",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon16.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": [
        "src/content/content.css"
      ],
      "js": [
        "src/content/result-ui.js",
        "src/content/runtime.js",
        "src/content/selection.js",
        "src/content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/icon16.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon16.png",
    "48": "assets/icons/icon16.png",
    "128": "assets/icons/icon16.png"
  }
}
