{
  "manifest_version": 3,
  "name": "Quick Converter",
  "version": "1.0.0",
  "description": "Select values on webpages and instantly convert units or currencies.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["https://api.frankfurter.dev/*"],
  "background": { "service_worker": "src/background/service-worker.js", "type": "module" },
  "action": { "default_title": "Quick Converter", "default_popup": "src/popup/popup.html" },
  "options_page": "src/options/options.html",
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["src/content/content.js"], "run_at": "document_start" }]
}
